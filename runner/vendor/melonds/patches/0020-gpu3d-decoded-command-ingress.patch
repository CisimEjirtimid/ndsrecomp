diff --git a/runner/vendor/melonds/GPU3D.cpp b/runner/vendor/melonds/GPU3D.cpp
index 70fe31f..7065586 100644
--- a/runner/vendor/melonds/GPU3D.cpp
+++ b/runner/vendor/melonds/GPU3D.cpp
@@ -2755,0 +2756,13 @@ void GPU3D::WriteToGXFIFO(u32 val) noexcept
+const u8* GPU3D::CommandParamCounts() noexcept { return CmdNumParams; }
+
+void GPU3D::WriteDecodedGXFIFO(u32 value, const u8* commands, u32 count) noexcept
+{
+    for (u32 i = 0; i < count; ++i)
+    {
+        CmdFIFOEntry entry;
+        entry.Command = commands[i];
+        entry.Param = value;
+        CmdFIFOWrite(entry);
+    }
+}
+
